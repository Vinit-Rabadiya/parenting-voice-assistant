{
  "name": "frontend",
  "private": true,
  "version": "0.2.1",
  "type": "module",
  "scripts": {
    "dev": "node ../scripts/disable-picomatch-extglobs.cjs && vite",
    "build": "node ../scripts/disable-picomatch-extglobs.cjs && vite build",
    "lint": "eslint .",
    "test": "npm run test:dependencies && npm run test:audio && npm run test:ui",
    "test:audio": "node --test ../tests/frontend/audio.test.mjs",
    "test:ui": "node ../scripts/disable-picomatch-extglobs.cjs && vitest run --config vitest.config.js",
    "test:workflow": "node ../scripts/disable-picomatch-extglobs.cjs && vitest run --config vitest.config.js tests/frontend/ConversationWorkflow.test.jsx",
    "preview": "node ../scripts/disable-picomatch-extglobs.cjs && vite preview",
    "check": "npm run lint && npm run test && npm run build",
    "postinstall": "node ../scripts/disable-picomatch-extglobs.cjs",
    "test:dependencies": "node --test ../tests/frontend/picomatch-policy.test.mjs"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.13.6",
    "minimatch": "^11.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "jsdom": "^29.1.1",
    "vite": "^8.3.0",
    "vitest": "^5.0.3"
  }
}
