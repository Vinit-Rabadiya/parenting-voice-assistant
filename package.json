{
  "name": "parenting-voice-assistant",
  "version": "1.0.0",
  "description": "AI-powered voice assistant and coaching system for caregivers.",
  "private": true,
  "type": "commonjs",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "dev:backend": "uvicorn backend.main:app --reload",
    "dev:frontend": "npm --prefix frontend run dev",
    "test": "node scripts/check.mjs",
    "test:backend": "pytest",
    "test:frontend": "npm --prefix frontend run test",
    "lint": "node scripts/check.mjs",
    "lint:backend": "ruff check .",
    "lint:frontend": "npm --prefix frontend run lint",
    "build:frontend": "npm --prefix frontend run build",
    "check": "node scripts/check.mjs",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vinit-Rabadiya/parenting-voice-assistant.git"
  },
  "keywords": [
    "ai",
    "voice-assistant",
    "fastapi",
    "react",
    "firebase"
  ],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Vinit-Rabadiya/parenting-voice-assistant/issues"
  },
  "homepage": "https://github.com/Vinit-Rabadiya/parenting-voice-assistant#readme",
  "devDependencies": {
    "firebase-admin": "^14.5.0",
    "husky": "^9.1.7"
  }
}
