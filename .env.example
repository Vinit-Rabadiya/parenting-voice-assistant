
# Server Settings
HOST=127.0.0.1
PORT=8000
APP_ENV=development
# The container serves the built web interface; Vite development keeps this false.
SERVE_FRONTEND=false
# Production requires exact API host names, for example api.example.com.
ALLOWED_HOSTS=
# Set true only after confirming active billing and the applicable paid-service terms.
# This is an operator confirmation, not automatic billing verification.
GEMINI_PAID_SERVICES_CONFIRMED=false
# Hosted free-tier testing: confirm that model requests contain only non-personal test material.
# This does not anonymize messages or enable billing. Keep the paid-services flag false.
GEMINI_NONPERSONAL_TESTING_CONFIRMED=false

# Firebase Admin SDK (Backend Authentication)
# Path can be relative to the project root (e.g. .secrets/firebase-admin.json) or absolute
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_ADMIN_KEY_PATH=.secrets/firebase-admin.json
# On Google-managed hosting, use an attached service account and unset the key path.
FIREBASE_USE_ADC=false
# MFA is optional by default. Administrators and accounts with mfa_required=true
# remain subject to mandatory MFA even when this setting is false.
AUTH_REQUIRE_MFA=false
# Reuse successful remote caregiver security checks for ordinary chat/read calls.
# JWT validity is checked every request; admin/security/deletion calls stay fresh.
# External revocation/policy changes can take this many seconds to affect chat.
# 0 disables reuse. Integer 0..18000; restart the backend after changing it.
# Token expiry and refresh still cap reuse; a 5-hour maximum is 18000.
AUTH_SESSION_CACHE_TTL_SECONDS=60

# Multilingual speech model used by the backend on CPU.
STT_MODEL=base

# Qdrant Vector Search
QDRANT_URL=https://your-cluster-url.qdrant.io
QDRANT_API_KEY=your-qdrant-api-key
QDRANT_COLLECTION=caregiver_guidance_everyday_v4
# Change after source/review updates in the same collection and restart the backend.
QDRANT_CORPUS_REVISION=
# Public reference results only, in memory, at most 128 entries. Set 0 to disable.
RETRIEVAL_CACHE_TTL_SECONDS=60
RETRIEVAL_MIN_SCORE=0.50
# Set false to withdraw Kenya schedule and vaccine-specific answers pending source review.
KENYA_VACCINATION_SCHEDULE_ENABLED=true

# Coaching responses: select gemini or groq. Changing provider requires new consent.
COACHING_PROVIDER=gemini
# Try the other provider once on quota errors; requires both keys and a dual-provider notice.
# In this mode, the per-provider FALLBACK_MODEL settings are ignored.
COACHING_PROVIDER_FAILOVER=false
# Skip a limited provider for this interval unless its retry metadata supplies a delay.
COACHING_PROVIDER_COOLDOWN_SECONDS=60
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash-lite
# Tried once only if the primary returns 429. Leave empty to disable.
GEMINI_FALLBACK_MODEL=gemini-3.8-flash
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=qwen/qwen3.8-27b
# No fallback by default. Optional Groq fallback is tried once on a 429 only.
GROQ_FALLBACK_MODEL=
# Independent confirmations for Groq; Gemini flags do not authorize Groq processing.
GROQ_DATA_TERMS_CONFIRMED=false
GROQ_NONPERSONAL_TESTING_CONFIRMED=false
