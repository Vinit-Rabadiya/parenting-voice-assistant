
# Server Settings
HOST=127.0.0.1
PORT=8000

# Firebase Admin SDK (Backend Authentication)
# Path can be relative to the project root (e.g. .secrets/firebase-admin.json) or absolute
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_ADMIN_KEY_PATH=.secrets/firebase-admin.json

# pretrained speech model used by the backend.
STT_MODEL=tiny.en

# Qdrant Vector Search
QDRANT_URL=https://your-cluster-url.qdrant.io
QDRANT_API_KEY=your-qdrant-api-key
QDRANT_COLLECTION=caregiver_guidance_everyday_v3
RETRIEVAL_MIN_SCORE=0.50

# Grounded coaching responses
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash-lite
# Tried once only if the primary returns 429. Leave empty to disable.
GEMINI_FALLBACK_MODEL=gemini-3.8-flash

# Per-account request limits. Positive integers; restart after changing them.
# Fixed hourly windows and calendar days in Africa/Nairobi (UTC+3).
COACH_HOURLY_LIMIT=30
COACH_DAILY_LIMIT=100
CHILD_CREATE_HOURLY_LIMIT=5
CHILD_CREATE_DAILY_LIMIT=20

